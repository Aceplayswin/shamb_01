NODE_ENV=development
PORT=8000
API_URL=http://localhost:8000
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,admin.ultraconic.com

# Master / control-plane DB (products, domains, branding, super admins).
MASTER_MYSQL_HOST=localhost
MASTER_MYSQL_PORT=3306
MASTER_MYSQL_USER=root
MASTER_MYSQL_PASSWORD=
MASTER_MYSQL_DATABASE=dollara_master

# Default MySQL credentials used when provisioning new tenant databases.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Optional override for the per-tenant schema SQL file.
# TENANT_SCHEMA_PATH=../../dollara/api/database/init.sql
