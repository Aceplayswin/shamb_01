NODE_ENV=development
PORT=8000
API_URL=http://localhost:8000
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,admin.ultraconic.com

# Master / control-plane DB (products, urls, branding, databases, themes, users).
MASTER_MYSQL_HOST=localhost
MASTER_MYSQL_PORT=3306
MASTER_MYSQL_USER=root
MASTER_MYSQL_PASSWORD=
MASTER_MYSQL_DATABASE=dollara_master

# Default MySQL credentials used as fallbacks for a product's tenant database
# connection info when not explicitly provided.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Optional override for the per-tenant schema SQL file.
# TENANT_SCHEMA_PATH=../../dollara/api/database/init.sql

# Products pull their own control-plane config from
# GET /api/v1/products/<slug>/config, authenticating with the X-Product-Token
# header. That header is normally the product's OWN api_key ("pk_...", issued at
# creation) — nothing needs to be set here for that per-product flow to work.
# This value is only an OPTIONAL global fallback secret accepted for every
# product (operator tooling / not-yet-migrated products). Leave empty to require
# each product to use its own api_key.
PRODUCT_CONFIG_TOKEN=
