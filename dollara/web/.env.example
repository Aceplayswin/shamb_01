# The product API base URL. This build serves a single product; the backend
# identifies it from its own api_key, so no tenant is configured here. Branding
# and the live theme are read from this API's keyless /api/v1/branding and
# /api/v1/theme endpoints.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws
