NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

# White-label: default tenant slug for local dev hosts (localhost) where no
# domain/subdomain is available. Override per environment.
NEXT_PUBLIC_DEFAULT_TENANT=dollara

# Super Admin control-plane API. The frontend reads branding + live theme from
# this service's public endpoints (/public/products/<slug>/branding|theme).
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8000
