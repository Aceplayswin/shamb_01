NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# White-label: default tenant slug for local dev hosts (localhost) where no
# domain/subdomain is available. Override per environment.
NEXT_PUBLIC_DEFAULT_TENANT=dollara

# Super Admin control plane — source of truth for the active UI theme. The web
# app reads which theme to render from this service's public theme endpoint.
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:5000
