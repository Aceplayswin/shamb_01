NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Multi-tenant databases ---
# Master / control-plane DB (products, urls, branding, databases, themes).
# Schema: super_admin/api/database/master.sql — provision via super_admin seed_master.
# The MASTER_* values are used for the Django `default` connection. If unset,
# they fall back to the MYSQL_* values below.
MASTER_MYSQL_HOST=localhost
MASTER_MYSQL_PORT=3306
MASTER_MYSQL_USER=root
MASTER_MYSQL_PASSWORD=
MASTER_MYSQL_DATABASE=dollara_master

# Default MySQL credentials. Also used as the default host/user/password when
# provisioning new tenant databases (each product gets its own DB).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dollara_master

# Default tenant slug for local dev hosts (localhost) without a domain.
DEFAULT_TENANT=dollara

# AWS (production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dollara-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Integrations (configure per environment)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=
MSG91_API_KEY=

# --- Game aggregator / provider integration ---
# Credentials and endpoints for the external game aggregator. NEVER hardcode
# these; the provider service reads them from the environment at runtime.
# AGENCY_UID identifies our agency account with the aggregator.
GAME_AGENCY_UID=
# AES-256-ECB key used to encrypt outbound launch payloads and decrypt inbound
# bet/win callbacks. Must match the key registered with the aggregator.
GAME_AES_SECRET_KEY=
# Prefix prepended to our internal user id to build the aggregator member_account
# (e.g. "h72add" + user_id). Keeps accounts namespaced per agency.
GAME_PLAYER_PREFIX=
# Base URL of the aggregator launch API (outbound). Must be a full HTTPS URL from
# your game provider — NOT the legacy placeholder "https://bet".
# Example: https://api.your-aggregator.com
GAME_SERVER_URL=
# Force the local mock game frame instead of calling the real aggregator.
# Set to 1 ONLY for local dev without provider credentials. Leave 0 (or unset)
# for live play — when 0 and GAME_SERVER_URL is a real host, real games launch.
# Note: in DEBUG, mock is auto-used if GAME_SERVER_URL is missing/placeholder,
# regardless of this flag.
GAME_MOCK_LAUNCH=0
# Launch path on the aggregator (default /game/v1). A bare "/" returns HTTP 403.
GAME_LAUNCH_PATH=/game/v1
# Public HTTPS base URL of THIS api that the aggregator posts callbacks to.
# Use the public URL registered with your provider in production (NOT localhost).
GAME_CALLBACK_BASE_URL=http://localhost:5000
# Path appended to GAME_CALLBACK_BASE_URL to form the callback_url sent to the
# aggregator. Default is our Django route /api/v1/games/callback.
# Winco legacy parity (shared agency account): set to /game/ and reverse-proxy
# /game/ to the games_callback view so the aggregator's registered URL resolves.
GAME_CALLBACK_PATH=/api/v1/games/callback
# Public HTTPS frontend URL passed to launched games (where "back to lobby"
# returns to). Use the public URL in production (NOT localhost).
GAME_HOME_URL=http://localhost:3000
# Currency / language defaults sent to the aggregator on launch.
GAME_CURRENCY_CODE=INR
GAME_DEFAULT_LANGUAGE=en
# Minimum main-wallet balance (in currency units) required to launch a game.
GAME_MIN_LAUNCH_BALANCE=100
# Outbound HTTP timeout (seconds) for aggregator launch requests.
GAME_HTTP_TIMEOUT=15
