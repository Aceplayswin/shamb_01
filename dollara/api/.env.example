NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
# Player site and partner portal, used server-side to build affiliate tracking
# redirects and sub-affiliate invite links.
WEB_URL=http://localhost:3000
AFFILIATE_URL=http://localhost:3003
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Control plane (Super Admin) ---
# Product identity, branding, theme and webhook keys are fetched from Super Admin
# over HTTP and cached (see services/control_plane.py) — no master DB connection.
# PRODUCT_CONFIG_TOKEN is this product's own api_key ("pk_..."), issued by Super
# Admin when the product was created (shown in the create response / product
# detail). It is the ONLY thing that identifies this instance: Super Admin resolves
# which product you are from this key alone (no slug), so the two sides talk iff a
# valid key is set here. Paste that exact key below.
SUPER_ADMIN_URL=http://localhost:8000
PRODUCT_CONFIG_TOKEN=pk_change-me-to-this-products-api-key
# Seconds to cache a fetched config before re-checking (default 60).
# CONTROL_PLANE_CACHE_TTL=60

# --- This product's own feature database (Django `default` connection) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dollara

# --- Super Admin signed-webhook data channel (Phase 2) ---
# Super Admin pulls product data, verified with the public key from the fetched
# control-plane config — so nothing is needed here normally. Set these only to
# pin a single key when the config endpoint is unreachable.
# SUPER_ADMIN_WEBHOOK_KEY_ID=sak_...
# SUPER_ADMIN_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# SUPER_ADMIN_WEBHOOK_PRODUCT=dollara

# --- AWS (production) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dollara-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Integrations (configure per environment) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=
MSG91_API_KEY=

# --- Game aggregator / provider integration ---
# Read from the environment at runtime; never hardcode.

# Agency account id with the aggregator.
GAME_AGENCY_UID=
# AES-256-ECB key for launch payloads and bet/win callbacks. Must match the
# key registered with the aggregator.
GAME_AES_SECRET_KEY=
# Prefix prepended to the internal user id to build member_account (e.g. "h72add").
GAME_PLAYER_PREFIX=
# Aggregator launch API base URL (outbound). Full HTTPS URL from your provider,
# e.g. https://api.your-aggregator.com — not the placeholder "https://bet".
GAME_SERVER_URL=
# Force the local mock game frame. Set to 1 for local dev without credentials;
# leave 0 for live play. In DEBUG, mock is auto-used when GAME_SERVER_URL is
# missing/placeholder regardless of this flag.
GAME_MOCK_LAUNCH=0
# Launch path on the aggregator (default /game/v1); bare "/" falls back to /game/v1.
GAME_LAUNCH_PATH=/game/v1
# Public HTTPS base URL of THIS api for callbacks. Falls back to API_URL when a
# public HTTPS URL. Not localhost in prod.
GAME_CALLBACK_BASE_URL=http://localhost:5000
# Path appended to GAME_CALLBACK_BASE_URL for callback_url (default
# /api/v1/games/callback; Winco/Huidu legacy shared agency uses /game/).
GAME_CALLBACK_PATH=/api/v1/games/callback
# Public HTTPS frontend URL for "back to lobby". Use the public URL in prod.
GAME_HOME_URL=http://localhost:3000
# Currency / language defaults sent on launch.
GAME_CURRENCY_CODE=INR
GAME_DEFAULT_LANGUAGE=en
# Minimum main-wallet balance required to launch a game.
GAME_MIN_LAUNCH_BALANCE=100
# Outbound HTTP timeout (seconds) for launch requests.
GAME_HTTP_TIMEOUT=15
