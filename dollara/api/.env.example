NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Control plane (Super Admin) ---
# dollara does NOT connect to the master/control-plane database. It fetches its
# product identity, branding, live theme and webhook public keys from Super Admin
# over HTTP and caches them (see services/control_plane.py).
# PRODUCT_CONFIG_TOKEN must match Super Admin's PRODUCT_CONFIG_TOKEN.
SUPER_ADMIN_URL=http://localhost:8000
PRODUCT_CONFIG_TOKEN=change-me-product-config-token
# Optional: seconds to cache a fetched config before re-checking (default 60).
# CONTROL_PLANE_CACHE_TTL=60

# --- This product's OWN feature database (the Django `default` connection) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dollara

# Default tenant slug for local dev hosts (localhost) without a domain.
DEFAULT_TENANT=dollara

# --- Super Admin signed-webhook data channel (Phase 2) ---
# Super Admin pulls product data over /api/v1/webhooks/super-admin/data/<resource>,
# signed with the product's private key. dollara verifies it using the public key
# from the control-plane config it fetches above (no master DB), so nothing is
# needed here. Only set these to PIN a single key when the config endpoint is
# unreachable:
# SUPER_ADMIN_WEBHOOK_KEY_ID=sak_...
# SUPER_ADMIN_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# SUPER_ADMIN_WEBHOOK_PRODUCT=dollara

# AWS (production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dollara-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Integrations (configure per environment)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=
MSG91_API_KEY=

# --- Game aggregator / provider integration ---
# Credentials and endpoints for the external game aggregator. NEVER hardcode
# these; the provider service reads them from the environment at runtime.
# AGENCY_UID identifies our agency account with the aggregator.
GAME_AGENCY_UID=
# AES-256-ECB key used to encrypt outbound launch payloads and decrypt inbound
# bet/win callbacks. Must match the key registered with the aggregator.
GAME_AES_SECRET_KEY=
# Prefix prepended to our internal user id to build the aggregator member_account
# (e.g. "h72add" + user_id). Keeps accounts namespaced per agency.
GAME_PLAYER_PREFIX=
# Base URL of the aggregator launch API (outbound). Must be a full HTTPS URL from
# your game provider — NOT the legacy placeholder "https://bet".
# Example: https://api.your-aggregator.com
GAME_SERVER_URL=
# Force the local mock game frame instead of calling the real aggregator.
# Set to 1 ONLY for local dev without provider credentials. Leave 0 (or unset)
# for live play — when 0 and GAME_SERVER_URL is a real host, real games launch.
# Note: in DEBUG, mock is auto-used if GAME_SERVER_URL is missing/placeholder,
# regardless of this flag.
GAME_MOCK_LAUNCH=0
# Launch path on the aggregator (default /game/v1). Bare "/" is rejected → uses /game/v1.
GAME_LAUNCH_PATH=/game/v1
# Public HTTPS base URL of THIS api for aggregator callbacks. Optional when API_URL
# is a public HTTPS URL (settings uses API_URL as fallback). NOT localhost in prod.
GAME_CALLBACK_BASE_URL=http://localhost:5000
# Path appended to GAME_CALLBACK_BASE_URL for callback_url in the launch payload.
# Default: /api/v1/games/callback. Winco/Huidu legacy (shared agency): /game/
GAME_CALLBACK_PATH=/api/v1/games/callback
# Public HTTPS frontend URL passed to launched games (where "back to lobby"
# returns to). Use the public URL in production (NOT localhost).
GAME_HOME_URL=http://localhost:3000
# Currency / language defaults sent to the aggregator on launch.
GAME_CURRENCY_CODE=INR
GAME_DEFAULT_LANGUAGE=en
# Minimum main-wallet balance (in currency units) required to launch a game.
GAME_MIN_LAUNCH_BALANCE=100
# Outbound HTTP timeout (seconds) for aggregator launch requests.
GAME_HTTP_TIMEOUT=15
