# The product API base URL. The admin console authenticates against this API's
# /api/v1/admin/* endpoints (keyed by the admin_token stored in this app's own
# origin) and reads branding from its keyless /api/v1/branding endpoint.
NEXT_PUBLIC_API_URL=http://localhost:5000

# The player-facing web app URL. Used only for outbound "View site" / "View
# player page" links in the console; the admin app never shares a session with it.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
